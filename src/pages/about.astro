---
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="About"
	description="A short introduction."
	pubDate={new Date('August 10 2026')}
	heroImage={AboutHeroImage}
>
	<p>I'm Cihan Andac.</p>

	<p>
		I made this site to write in public — mostly short notes on things I'm building and learning,
		kept rough on purpose. I'd rather publish something small than sit on a draft.
	</p>

	<p>
		You can find my code on <a href="https://github.com/cihanandac">GitHub</a>.
	</p>
</Layout>
