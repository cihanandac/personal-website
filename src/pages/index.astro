---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Cihan</h1>
			<p>
				This is my personal site — a place to write things down as I go, rather than a polished
				portfolio.
			</p>
			<p>
				Most of it will end up on the <a href="/blog">blog</a>: short notes on what I'm building,
				reading, and working out along the way.
			</p>
			<p>It's early days here. More soon.</p>
		</main>
		<Footer />
	</body>
</html>
